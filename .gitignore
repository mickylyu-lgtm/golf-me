# iOS / Xcode — the native project shell is committed, but generated/
# user-specific artifacts are not. Web assets under ios/App/App/public are
# regenerated by `npm run ios:sync` (which runs `npx cap sync ios`), never
# hand-edited.
ios/App/App/public
ios/App/Pods
ios/App/Podfile.lock
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData
ios/.build
